<?xml version="1.0" encoding="utf-8"?>
<!--
  Empty-slot background. Default = surface fill. On stylus/mouse hover the cell
  previews the click action with accent-dim fill + accent border, mirroring the
  main app's `.toggle-btn:hover` on empty positive slots. Touch never fires
  hover events, so on a finger-only device this looks identical to the prior
  static shape.

  Caveat: negative-goal "success" slots also use this drawable (empty visual)
  but clicking them would mark a FAILURE — so the accent preview is technically
  misleading there. Living with it for now; can fork to a *_neg variant later.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_accent_dim" />
            <stroke android:width="1dp" android:color="@color/widget_accent" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
