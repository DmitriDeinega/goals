<?xml version="1.0" encoding="utf-8"?>
<!--
  Default background for non-selected day cells in the widget's week strip.
  Transparent at rest; on stylus/mouse hover gets an accent border (no fill)
  to match the main app's `.day-btn:hover` style. Selected days use
  widget_day_selected (accent-dim fill + accent border) instead.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/widget_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
