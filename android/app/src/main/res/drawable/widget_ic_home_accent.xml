<?xml version="1.0" encoding="utf-8"?>
<!--
  Outline of a house (mirrors the ⌂ glyph U+2302). Single closed pentagon
  drawn as a stroke: walls vertical, roof a triangle on top.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/widget_accent"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M5,21 L5,12 L12,4 L19,12 L19,21 Z" />
</vector>
