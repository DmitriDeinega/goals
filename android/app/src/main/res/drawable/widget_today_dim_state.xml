<?xml version="1.0" encoding="utf-8"?>
<!--
  Today (⌂) icon when already on today (dim, click is a no-op). No hover
  scale since the icon isn't usefully interactive in this state — matches
  the main app where the home glyph stops being clickable when already home.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/widget_ic_home_dim"
    android:insetLeft="3dp"
    android:insetTop="3dp"
    android:insetRight="3dp"
    android:insetBottom="3dp" />
