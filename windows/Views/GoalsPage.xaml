<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Goals_Windows.Views.GoalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:Goals_Windows.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource GoalsBgBrush}"
    mc:Ignorable="d">

    <Grid Padding="20,12,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Text="No goals yet. Click + New Goal to add one."
            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{StaticResource GoalsText2Brush}" />

        <ListView
            x:Name="GoalsList"
            ItemsSource="{x:Bind ViewModel.Cards}"
            CanReorderItems="True"
            CanDragItems="True"
            AllowDrop="True"
            IsItemClickEnabled="True"
            SelectionMode="None"
            ItemClick="OnCardClicked"
            DragItemsCompleted="OnCardDragCompleted"
            ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <!-- Reposition animates only the cards that actually moved when
                 the ObservableCollection emits a Move (remote reorder via SSE
                 path goes through `Rebuild`'s Move loop, not Clear+Add). -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <!-- Zero the ListViewItemPresenter hover/selected/pressed brushes
                 at the ListView scope so the card Border's own hover paint is
                 what the user sees. Setting these via ItemContainerStyle setters
                 fails (the props live on the presenter, not on ListViewItem). -->
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver"         Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected"            Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed"     Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed"             Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:GoalCardViewModel">
                    <Border
                        Background="{StaticResource GoalsSurfaceBrush}"
                        BorderBrush="{StaticResource GoalsBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource GoalsRadius}"
                        Padding="14,12"
                        Loaded="OnCardLoaded">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="&#x283F;"
                                FontFamily="Segoe UI Symbol"
                                FontSize="20"
                                Foreground="{StaticResource GoalsText3Brush}"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" Opacity="{x:Bind NameOpacity, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind Name, Mode=OneWay}"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource GoalsTextBrush}" />
                                    <Border
                                        Style="{StaticResource AvoidTagStyle}"
                                        Visibility="{x:Bind NegativeBadgeVisibility, Mode=OneWay}">
                                        <TextBlock
                                            Text="avoid"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            CharacterSpacing="100"
                                            Foreground="{StaticResource GoalsRedBrush}" />
                                    </Border>
                                    <Border
                                        Background="{StaticResource GoalsBorder2Brush}"
                                        CornerRadius="4"
                                        Padding="5,2"
                                        Visibility="{x:Bind PausedBadgeVisibility, Mode=OneWay}">
                                        <TextBlock
                                            Text="paused"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            CharacterSpacing="100"
                                            Foreground="{StaticResource GoalsText3Brush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Text="{x:Bind Meta, Mode=OneWay}"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="{StaticResource GoalsText3Brush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- "+ NEW GOAL": dashed border via Rectangle layered behind a borderless
             Button. Hover state is wired in code-behind from Loaded to dodge a
             XAML-compiler quirk that rejects PointerEntered directly on Border
             elements inside data templates. -->
        <Grid Grid.Row="1" Loaded="OnNewGoalGridLoaded">
            <Rectangle
                x:Name="NewGoalDash"
                Stroke="{StaticResource GoalsBorder2Brush}"
                StrokeThickness="1"
                StrokeDashArray="3,3"
                RadiusX="12"
                RadiusY="12" />
            <Button
                x:Name="NewGoalBtn"
                HorizontalAlignment="Stretch"
                Padding="0,14"
                FontSize="13"
                FontWeight="SemiBold"
                CharacterSpacing="80"
                Foreground="{StaticResource GoalsText3Brush}"
                BorderThickness="0"
                Background="Transparent"
                Content="+ NEW GOAL"
                Command="{x:Bind ViewModel.NewGoalCommand}" />
        </Grid>
    </Grid>
</Page>
