<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Goals_Windows.Views.GoalFormDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:Goals_Windows.ViewModels"
    xmlns:c="using:Goals_Windows.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource GoalsSurfaceBrush}"
    BorderBrush="{StaticResource GoalsBorderBrush}"
    BorderThickness="1"
    CornerRadius="{StaticResource GoalsRadius}"
    VerticalAlignment="Top"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <!-- Hide the TextBox's inline X (DeleteButton in WinUI's TextBox
             template). Scoped to the dialog. -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!-- TextBox/NumberBox focus underline (the 2px line at the bottom of
             the input on focus). Make uniform 1px so the border just shifts
             color on focus, no underline. Hover stays neutral grey — only
             focus turns yellow (user spec). -->
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#C8F135" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2E2E2E" />

        <!-- Implicit style: every CleanNumberBox in this dialog gets the same
             visual treatment as the Name TextBox (surface2 bg, neutral 1px
             border, sm corners, padded). Without this, NumberBox falls back to
             the system style which has BorderThickness=1,1,1,2 — the 2px
             bottom edge reads as a "weird underline" next to the flat
             1px-bordered TextBox above it. -->
        <Style TargetType="c:CleanNumberBox">
            <Setter Property="Background" Value="{StaticResource GoalsSurface2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoalsBorder2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource GoalsTextBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource GoalsRadiusSm}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,12" />
        </Style>

        <!-- Field-label text: 10px bold uppercase muted, matches web/Android. -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource GoalsText3Brush}" />
            <Setter Property="CharacterSpacing" Value="150" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Save button: lime fill, dark text, slight opacity bump on hover. -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GoalsAccentBrush}" />
            <Setter Property="Foreground" Value="#0A0A0A" />
            <Setter Property="BorderBrush" Value="{StaticResource GoalsAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="CornerRadius" Value="{StaticResource GoalsRadiusSm}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- Cancel / neutral button. Per-Button Resources override the hover
             paint to lime text+border (no bg fill) — matches the unified
             hover language we're trying everywhere. -->
        <Style x:Key="NeutralButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource GoalsText2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoalsBorder2Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="CornerRadius" Value="{StaticResource GoalsRadiusSm}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="DeleteTextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource GoalsRedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="380" Background="Transparent" Tapped="OnRootTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
                FontSize="16"
                FontWeight="Bold"
                CharacterSpacing="60"
                VerticalAlignment="Center"
                Foreground="{StaticResource GoalsTextBrush}" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="16"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.EditActionsVisibility, Mode=OneWay}">
                <Button
                    Click="OnDeleteClick"
                    Loaded="OnDeleteButtonLoaded"
                    Style="{StaticResource DeleteTextButtonStyle}"
                    Content="DELETE">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#FF4444" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="#FF4444" />
                    </Button.Resources>
                </Button>
                <ToggleSwitch IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" Loaded="OnCursorOnlyLoaded" OnContent="" OffContent="" MinWidth="0">
                    <ToggleSwitch.Resources>
                        <!-- Normal-state keys: Brushes (ObjectAnimation targets the full Background/Fill brush). -->
                        <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOff"             Color="#2E2E2E" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOff"           Color="Transparent" />
                        <!-- Hover/Pressed/Disabled keys for off state: Colors.
                             ColorAnimation targets (SolidColorBrush.Color), so
                             these MUST be `<Color>` resources — defining them
                             as SolidColorBrush leaves the chrome unable to
                             resolve the Color and falls back to Black, which
                             makes the track animate grey → black on hover. -->
                        <Color x:Key="ToggleSwitchContainerBackgroundPointerOver">#00000000</Color>
                        <Color x:Key="ToggleSwitchContainerBackgroundPressed">#00000000</Color>
                        <Color x:Key="ToggleSwitchContainerBackgroundDisabled">#00000000</Color>
                        <Color x:Key="ToggleSwitchFillOffPointerOver">#FF2E2E2E</Color>
                        <Color x:Key="ToggleSwitchFillOffPressed">#FF2E2E2E</Color>
                        <Color x:Key="ToggleSwitchStrokeOffPointerOver">#00000000</Color>
                        <Color x:Key="ToggleSwitchStrokeOffPressed">#00000000</Color>
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff"          Color="#0A0A0A" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#0A0A0A" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed"   Color="#0A0A0A" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOn"               Color="#C8F135" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver"    Color="#C8F135" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"        Color="#C8F135" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled"       Color="#3FC8F135" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOn"             Color="#C8F135" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver"  Color="#C8F135" />
                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"      Color="#C8F135" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"           Color="#0A0A0A" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0A0A0A" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed"     Color="#0A0A0A" />
                    </ToggleSwitch.Resources>
                </ToggleSwitch>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="NAME" />
                    <!-- Name input: surface2 bg, neutral border by default; accent
                         border on focus / hover (web's `.field input:focus`). -->
                    <TextBox
                        x:Name="NameBox"
                        Style="{StaticResource NoClearButtonTextBoxStyle}"
                        Background="{StaticResource GoalsSurface2Brush}"
                        BorderBrush="{StaticResource GoalsBorder2Brush}"
                        BorderThickness="1"
                        Foreground="{StaticResource GoalsTextBrush}"
                        CornerRadius="{StaticResource GoalsRadiusSm}"
                        Padding="12,12"
                        FontSize="14"
                        Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="e.g. Morning run"
                        MaxLength="80">
                        <TextBox.Resources>
                            <!-- Hover stays neutral; focus turns yellow. -->
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2E2E2E" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused"     Color="#C8F135" />
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="TYPE" />
                    <!-- Border + Tapped: Button's VSM forces a hover bg change
                         that the user explicitly doesn't want (only border +
                         text should react on hover). Custom code-behind
                         handles state + hover paint. -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="DailyOption"
                            Loaded="OnTypeOptionLoaded"
                            Tapped="OnDailyTapped"
                            Background="{x:Bind ViewModel.DailyButtonBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.DailyButtonBorder, Mode=OneWay}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource GoalsRadiusSm}"
                            HorizontalAlignment="Stretch"
                            Padding="10,10">
                            <TextBlock
                                Text="DAILY"
                                HorizontalAlignment="Center"
                                IsHitTestVisible="False"
                                FontSize="11"
                                FontWeight="SemiBold"
                                CharacterSpacing="60"
                                Foreground="{x:Bind ViewModel.DailyButtonForeground, Mode=OneWay}" />
                        </Border>
                        <Border
                            x:Name="WeeklyOption"
                            Grid.Column="1"
                            Loaded="OnTypeOptionLoaded"
                            Tapped="OnWeeklyTapped"
                            Background="{x:Bind ViewModel.WeeklyButtonBackground, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.WeeklyButtonBorder, Mode=OneWay}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource GoalsRadiusSm}"
                            HorizontalAlignment="Stretch"
                            Padding="10,10">
                            <TextBlock
                                Text="WEEKLY"
                                HorizontalAlignment="Center"
                                IsHitTestVisible="False"
                                FontSize="11"
                                FontWeight="SemiBold"
                                CharacterSpacing="60"
                                Foreground="{x:Bind ViewModel.WeeklyButtonForeground, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="{x:Bind ViewModel.DailyVisibility, Mode=OneWay}">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="TIMES PER DAY" />
                    <c:CleanNumberBox
                        Value="{x:Bind ViewModel.TimesPerDay, Mode=TwoWay}"
                        Minimum="1"
                        Maximum="4"
                        SpinButtonPlacementMode="Hidden" />
                </StackPanel>

                <StackPanel Visibility="{x:Bind ViewModel.WeeklyVisibility, Mode=OneWay}">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="TIMES PER WEEK" />
                    <c:CleanNumberBox
                        Value="{x:Bind ViewModel.TimesPerWeek, Mode=TwoWay}"
                        Minimum="1"
                        Maximum="7"
                        SpinButtonPlacementMode="Hidden"
                        Loaded="OnTimesPerWeekLoaded" />
                </StackPanel>

                <!-- Negative goal as a bordered surface2 row (matches web's
                     `.toggle-field` and Android's bordered Row). Padding kept
                     low — web uses min-height:52px which is roughly 10,12. -->
                <Border
                    Background="{StaticResource GoalsSurface2Brush}"
                    BorderBrush="{StaticResource GoalsBorder2Brush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource GoalsRadiusSm}"
                    Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="Negative goal (avoid habit)"
                            FontSize="13"
                            Foreground="{StaticResource GoalsText2Brush}"
                            VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsNegative, Mode=TwoWay}" Loaded="OnCursorOnlyLoaded" OnContent="" OffContent="" MinWidth="0">
                            <ToggleSwitch.Resources>
                                <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleSwitchFillOff"             Color="#2E2E2E" />
                                <SolidColorBrush x:Key="ToggleSwitchStrokeOff"           Color="Transparent" />
                                <Color x:Key="ToggleSwitchContainerBackgroundPointerOver">#00000000</Color>
                                <Color x:Key="ToggleSwitchContainerBackgroundPressed">#00000000</Color>
                                <Color x:Key="ToggleSwitchContainerBackgroundDisabled">#00000000</Color>
                                <Color x:Key="ToggleSwitchFillOffPointerOver">#FF2E2E2E</Color>
                                <Color x:Key="ToggleSwitchFillOffPressed">#FF2E2E2E</Color>
                                <Color x:Key="ToggleSwitchStrokeOffPointerOver">#00000000</Color>
                                <Color x:Key="ToggleSwitchStrokeOffPressed">#00000000</Color>
                                <SolidColorBrush x:Key="ToggleSwitchKnobFillOff"          Color="#0A0A0A" />
                                <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#0A0A0A" />
                                <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed"   Color="#0A0A0A" />
                                <SolidColorBrush x:Key="ToggleSwitchFillOn"               Color="#C8F135" />
                                <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver"    Color="#C8F135" />
                                <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"        Color="#C8F135" />
                                <SolidColorBrush x:Key="ToggleSwitchStrokeOn"             Color="#C8F135" />
                                <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver"  Color="#C8F135" />
                                <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"      Color="#C8F135" />
                                <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"           Color="#0A0A0A" />
                                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0A0A0A" />
                                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed"     Color="#0A0A0A" />
                            </ToggleSwitch.Resources>
                        </ToggleSwitch>
                    </Grid>
                </Border>

                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="REWARD RULES (OPTIONAL)" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RewardRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RewardRuleViewModel">
                                <!-- One-line rule: [n] /max → [reward] [×]. Matches
                                     `.reward-rule-row` on web and Android. -->
                                <Grid Margin="0,0,0,8" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <c:CleanNumberBox
                                        Value="{x:Bind MinCompletions, Mode=TwoWay}"
                                        Minimum="1"
                                        Maximum="7"
                                        SpinButtonPlacementMode="Hidden" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind MaxLabel, Mode=OneWay}"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="{StaticResource GoalsText3Brush}"
                                        VerticalAlignment="Center" />
                                    <c:CleanNumberBox
                                        Grid.Column="2"
                                        Value="{x:Bind RewardAmount, Mode=TwoWay}"
                                        Minimum="0.5"
                                        SmallChange="0.5"
                                        SpinButtonPlacementMode="Hidden" />
                                    <Button
                                        Grid.Column="3"
                                        Click="OnRemoveRuleClick"
                                        Loaded="OnCursorOnlyLoaded"
                                        Tag="{x:Bind}"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource GoalsBorder2Brush}"
                                        BorderThickness="1"
                                        Foreground="{StaticResource GoalsText3Brush}"
                                        CornerRadius="{StaticResource GoalsRadiusSm}"
                                        Padding="0"
                                        Width="32"
                                        Height="32"
                                        Content="&#x2715;">
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF4444" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="#FF4444" />
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#FF4444" />
                                            <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="#FF4444" />
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- + Add Rule: dashed border via Rectangle layered behind a
                         borderless Button. The wrapper Grid listens to pointer
                         events so the dashed stroke can highlight on hover. -->
                    <Grid
                        x:Name="AddRuleWrapper"
                        PointerEntered="OnAddRuleHoverEnter"
                        PointerExited="OnAddRuleHoverExit">
                        <Rectangle
                            x:Name="AddRuleDash"
                            Stroke="{StaticResource GoalsBorder2Brush}"
                            StrokeThickness="1"
                            StrokeDashArray="3,3"
                            RadiusX="8"
                            RadiusY="8" />
                        <Button
                            Command="{x:Bind ViewModel.AddRuleCommand}"
                            Loaded="OnCursorOnlyLoaded"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource GoalsText3Brush}"
                            x:Name="AddRuleBtn"
                            Padding="14,10"
                            FontSize="11"
                            FontWeight="Bold"
                            CharacterSpacing="80"
                            HorizontalAlignment="Stretch"
                            CornerRadius="{StaticResource GoalsRadiusSm}"
                            Content="+ ADD RULE">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#C8F135" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="#C8F135" />
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>

                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Error"
                    Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="10" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Button container size stays fixed; the inner TextBlock scales
                 1.1× on hover so only the glyphs grow (matches the web's
                 font-size bump). Container size never changes. -->
            <Button
                Click="OnCancelClick"
                Loaded="OnCancelButtonLoaded"
                Style="{StaticResource NeutralButtonStyle}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#C8F135" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="#C8F135" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#C8F135" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="#C8F135" />
                </Button.Resources>
                <TextBlock x:Name="CancelText" Text="CANCEL" IsHitTestVisible="False" />
            </Button>
            <Button
                x:Name="SaveBtn"
                Grid.Column="1"
                Click="OnSaveClick"
                Loaded="OnSaveButtonLoaded"
                Style="{StaticResource AccentButtonStyle}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#C8F135" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#C8F135" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#C8F135" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="#C8F135" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#0A0A0A" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="#0A0A0A" />
                </Button.Resources>
                <TextBlock x:Name="SaveText" Text="SAVE" IsHitTestVisible="False" Foreground="#0A0A0A" />
            </Button>
        </Grid>
    </Grid>
</ContentDialog>
