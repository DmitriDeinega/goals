<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Goals_Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Goals_Windows"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Goals"
    mc:Ignorable="d">


    <Grid Background="{StaticResource GoalsBgBrush}">
        <!-- NormalLayout: everything that's visible at full size. Hidden
             when collapsed; replaced by the icon-only overlay below. -->
        <Grid x:Name="NormalLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- TitleBar's RightHeader slot was inconsistent in our SDK — the
             button kept landing in the title area, not next to the system X.
             Putting the TitleBar in a Grid and overlaying the collapse
             button absolute-positioned (top-right + 46dp right margin to
             clear the X) sidesteps the slot behaviour entirely. -->
        <Grid>
            <TitleBar
                x:Name="AppTitleBar"
                Background="{StaticResource GoalsBgBrush}"
                PointerPressed="OnTitleBarPointerPressed"
                PointerMoved="OnTitleBarPointerMoved"
                PointerReleased="OnTitleBarPointerReleased"
                PointerCaptureLost="OnTitleBarPointerReleased">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/AppIcon.ico" />
                </TitleBar.IconSource>
            </TitleBar>
            <!-- Single-line ─ (hide-to-tray): leftmost of the custom caption
                 buttons. Margin="0,0,92,0" pushes it 46+46=92 in from the
                 right so it sits left of the ═ which is in turn left of X. -->
            <Button
                x:Name="MinimizeButton"
                Click="OnMinimizeClick"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Margin="0,0,46,0"
                Width="46"
                Height="32"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                CornerRadius="0"
                Foreground="{StaticResource GoalsAccentBrush}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#2A2A2A" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#3A3A3A" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#C8F135" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="#C8F135" />
                    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                </Button.Resources>
                <TextBlock
                    Text="─"
                    FontSize="14"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    LineHeight="14"
                    TextAlignment="Center" />
            </Button>
            <Button
                x:Name="CollapseButton"
                Click="OnCollapseClick"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Margin="0,0,0,0"
                Width="46"
                Height="32"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                CornerRadius="0"
                Foreground="{StaticResource GoalsAccentBrush}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#2A2A2A" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#3A3A3A" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#C8F135" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="#C8F135" />
                    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                </Button.Resources>
                <TextBlock
                    Text="═"
                    FontSize="14"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    LineHeight="14"
                    TextAlignment="Center" />
            </Button>
        </Grid>

        <!-- Custom two-tab strip — 50/50 split with a lime underline under the
             active tab. Avoids the SelectorBar autosizing quirk that
             over-inflated the selected item. -->
        <Grid Grid.Row="1" Margin="20,8,20,0" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="TabToday"
                Grid.Column="0"
                Background="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="0,12,0,8"
                FontSize="13"
                FontWeight="SemiBold"
                CharacterSpacing="80"
                Click="OnTabTodayClick"
                Loaded="OnTabLoaded"
                PointerEntered="OnTabPointerEntered"
                PointerExited="OnTabPointerExited"
                Foreground="{StaticResource GoalsTextBrush}"
                Content="TODAY">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="Transparent" />
                    <!-- VSM would otherwise drop hover text to the system
                         accent color (often lime/yellow). Pin it to white so
                         hover matches the web's `.tab:hover { color: text }`. -->
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="#F0F0F0" />
                </Button.Resources>
            </Button>
            <Border
                Grid.Row="1"
                Grid.Column="0"
                x:Name="TabTodayIndicator"
                Height="3"
                CornerRadius="2"
                HorizontalAlignment="Stretch"
                Margin="40,0,40,0"
                Background="{StaticResource GoalsAccentBrush}" />

            <Button
                x:Name="TabGoals"
                Grid.Column="1"
                Background="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="0,12,0,8"
                FontSize="13"
                FontWeight="SemiBold"
                CharacterSpacing="80"
                Click="OnTabGoalsClick"
                Loaded="OnTabLoaded"
                PointerEntered="OnTabPointerEntered"
                PointerExited="OnTabPointerExited"
                Foreground="{StaticResource GoalsText2Brush}"
                Content="GOALS">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="Transparent" />
                    <!-- VSM would otherwise drop hover text to the system
                         accent color (often lime/yellow). Pin it to white so
                         hover matches the web's `.tab:hover { color: text }`. -->
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="#F0F0F0" />
                </Button.Resources>
            </Button>
            <Border
                Grid.Row="1"
                Grid.Column="1"
                x:Name="TabGoalsIndicator"
                Height="3"
                CornerRadius="2"
                HorizontalAlignment="Stretch"
                Margin="40,0,40,0"
                Background="Transparent" />
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="2" />
        </Grid>

        <!-- Tray icon — declared in XAML so the MenuFlyout sits inside the
             window's visual tree with a real XamlRoot. Programmatic
             instantiation had MenuFlyoutItem.Click silently no-op'ing
             (no XamlRoot to deliver the click to). Grid.Row=0 keeps it in
             the same cell as the title bar; the control is invisible. -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            Grid.Row="0"
            ToolTipText="Goals"
            IconSource="ms-appx:///Assets/AppIcon.ico">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <!-- Command binding rather than Click — H.NotifyIcon
                         hosts the flyout in a separate XamlRoot from the
                         window, so Click routed events never reach our
                         handler. ICommand goes through a dispatcher path
                         that survives the hosting hop. -->
                    <MenuFlyoutItem Text="Quit" Command="{x:Bind QuitCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- CollapsedOverlay: shown when the window is shrunk to icon size.
             Fills the tiny window with the app icon and acts as one big
             click target that restores the normal layout. Padding/border
             kept minimal so the icon dominates the footprint. -->
        <Button
            x:Name="CollapsedOverlay"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Padding="0"
            Background="{StaticResource GoalsBgBrush}"
            BorderBrush="{StaticResource GoalsAccentBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Click="OnRestoreClick">
            <Button.ContextFlyout>
                <!-- Right-click the collapsed icon → one-item Minimize.
                     Hides the icon to tray (same as the ─ button in the
                     expanded title bar). Click event fires natively here
                     because the flyout is in the main window's XamlRoot. -->
                <MenuFlyout Placement="Top">
                    <MenuFlyout.MenuFlyoutPresenterStyle>
                        <Style TargetType="MenuFlyoutPresenter">
                            <Setter Property="Background" Value="{StaticResource GoalsSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource GoalsAccentBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="MinWidth" Value="120" />
                        </Style>
                    </MenuFlyout.MenuFlyoutPresenterStyle>
                    <MenuFlyoutItem
                        Text="Minimize"
                        Click="OnCollapsedMinimizeClick"
                        Foreground="{StaticResource GoalsTextBrush}"
                        FontSize="13">
                        <MenuFlyoutItem.Resources>
                            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#1FC8F135" />
                            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed"     Color="#1FC8F135" />
                            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#C8F135" />
                            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed"     Color="#C8F135" />
                        </MenuFlyoutItem.Resources>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.ContextFlyout>
            <!-- High-res (512px) source: the collapsed widget is ~400 physical px
                 at 200% scale, so the 256px-max AppIcon.ico would be upscaled and
                 look soft. AppIconLarge.png downscales cleanly instead. -->
            <Image Source="Assets/AppIconLarge.png" Stretch="UniformToFill" />
        </Button>
    </Grid>
</Window>
