<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Design tokens shared with frontend/src/index.css (:root) and
        android/.../res/values/colors.xml. Keep in sync.
    -->
    <SolidColorBrush x:Key="GoalsBgBrush"          Color="#0A0A0A" />
    <SolidColorBrush x:Key="GoalsSurfaceBrush"     Color="#111111" />
    <SolidColorBrush x:Key="GoalsSurface2Brush"    Color="#1A1A1A" />
    <SolidColorBrush x:Key="GoalsBorderBrush"      Color="#222222" />
    <SolidColorBrush x:Key="GoalsBorder2Brush"     Color="#2E2E2E" />
    <SolidColorBrush x:Key="GoalsTextBrush"        Color="#F0F0F0" />
    <SolidColorBrush x:Key="GoalsText2Brush"       Color="#888888" />
    <SolidColorBrush x:Key="GoalsText3Brush"       Color="#444444" />
    <SolidColorBrush x:Key="GoalsAccentBrush"      Color="#C8F135" />
    <SolidColorBrush x:Key="GoalsAccentDimBrush"   Color="#1FC8F135" />
    <SolidColorBrush x:Key="GoalsAccentDim2Brush"  Color="#0FC8F135" />
    <SolidColorBrush x:Key="GoalsRedBrush"         Color="#FF4444" />
    <SolidColorBrush x:Key="GoalsRedDimBrush"      Color="#1FFF4444" />

    <CornerRadius    x:Key="GoalsRadius">12</CornerRadius>
    <CornerRadius    x:Key="GoalsRadiusSm">8</CornerRadius>
    <CornerRadius    x:Key="GoalsRadiusXs">6</CornerRadius>

    <Style x:Key="SlotButtonStyle" TargetType="Button">
        <Setter Property="Width"            Value="36" />
        <Setter Property="Height"           Value="36" />
        <Setter Property="Padding"          Value="0" />
        <Setter Property="MinWidth"         Value="36" />
        <Setter Property="MinHeight"        Value="36" />
        <Setter Property="BorderThickness"  Value="2" />
        <Setter Property="CornerRadius"     Value="18" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Background"       Value="Transparent" />
        <Setter Property="BorderBrush"      Value="{StaticResource GoalsBorder2Brush}" />
    </Style>

    <Style x:Key="AvoidTagStyle" TargetType="Border">
        <Setter Property="Background"   Value="{StaticResource GoalsRedDimBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding"      Value="5,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WeekDayCellStyle" TargetType="Button">
        <Setter Property="MinWidth"        Value="0" />
        <Setter Property="Height"          Value="56" />
        <Setter Property="Padding"         Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderBrush"     Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource GoalsRadiusSm}" />
        <!-- Suppress the post-click focus ring; it can land on the selected
             day after a click and read as the text getting "bigger". -->
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <Style x:Key="WeekNavButtonStyle" TargetType="Button">
        <Setter Property="Width"           Value="28" />
        <Setter Property="Height"          Value="28" />
        <Setter Property="MinWidth"        Value="28" />
        <Setter Property="MinHeight"       Value="28" />
        <Setter Property="Padding"         Value="0" />
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderBrush"     Value="{StaticResource GoalsBorder2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource GoalsRadiusSm}" />
        <Setter Property="FontSize"        Value="16" />
        <Setter Property="Foreground"      Value="{StaticResource GoalsText2Brush}" />
    </Style>

    <Style x:Key="TodayResetButtonStyle" TargetType="Button">
        <Setter Property="Width"           Value="32" />
        <Setter Property="Height"          Value="32" />
        <Setter Property="MinWidth"        Value="32" />
        <Setter Property="Padding"         Value="0" />
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderBrush"     Value="{StaticResource GoalsBorder2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource GoalsRadiusSm}" />
        <Setter Property="FontSize"        Value="14" />
        <Setter Property="Foreground"      Value="{StaticResource GoalsAccentBrush}" />
    </Style>
</ResourceDictionary>
